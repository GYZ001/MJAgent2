# 容器化部署配置样例——复制为 .env 并填真实值：
#   cp .env.example .env
# 不含任何真实密钥；.env 本身已在 .gitignore 里，不要提交。
#
# 裸机/systemd 部署（生产 B）用的是仓库根目录另一份 .env，两者互不影响，见
# docs/deploy-two-servers.md；本文件只服务 docker-compose.yml 这条新交付路径。

# --- 部署画像 ---
DEPLOYMENT_PROFILE=saas

# --- 模型供应商（至少配置一个，否则 scripts/preflight.py 会报 FAIL）---
# HiAgent（开发期默认主力供应商）
HIAGENT_API_KEY=
HIAGENT_BASE_URL=https://hia.volcenginepaas.com/api/aigw/v1

# OpenRouter（可选）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 阿里百炼（可选；也接受 DASHSCOPE_API_KEY 作为回退，见 app/config.py）
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 智谱（可选）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# MiniMax-H3 视频（可选；视频生成有额度上限，配置前请确认额度）
MINIMAX_H3_API_KEY=
MINIMAX_H3_BASE_URL=

# --- 首次启动引导系统管理员（仅当 users 表为空时生效，见
#     scripts/create_admin.py --from-env）；留空则跳过自动引导，改用
#     `docker compose exec app python scripts/create_admin.py --username admin`
#     手动建号 ---
MJ_BOOTSTRAP_ADMIN_USER=
MJ_BOOTSTRAP_ADMIN_PASSWORD=

# --- GET /metrics 授权（PRD §5：默认不裸奔到公网，系统管理员会话或此 token
#     二选一）；留空则只有系统管理员会话能访问 ---
MJ_METRICS_TOKEN=

# --- /media 访问票据（默认开启校验；仅联调排障时可临时设为 0）---
MJ_MEDIA_REQUIRE_TICKET=1

# --- 兼容期共享会话开关（默认关闭；仅未接入正式登录的老联调环境需要）---
MJ_LEGACY_SHARED_SESSION=0

# --- nginx 对外端口（宿主机侧）---
MJ_HTTP_PORT=8080
# MJ_HTTPS_PORT=8443   # 挂真实证书后再启用，见 docker-compose.yml 里的说明
