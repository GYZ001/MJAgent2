  "scene_inputs": [
    {
      "scene_plan_key": "bp-sc013",
      "node_keys": ["S002-S001-N014"],
      "source_segments": [
        {"source_segment_id": "SRC0049", "text": "当他睁开眼睛时，已经在了一处半山腰的青石空地上，四周山峦起伏，云雾缭绕绝非凡尘，能看到一些精美的阁楼环绕山峦八方，满眼陌生。"},
        {"source_segment_id": "SRC0050", "text": "他身边王有材以及另外两个少年，此刻都已苏醒过来，正身子颤抖惊恐的望着前方背对着四人的女子。"},
        {"source_segment_id": "SRC0051", "text": "在这女子的前方，有两个穿着绿色长袍的男子，年纪看起来都是二十许岁，但都是双眼凹陷，瞳孔绿油油的，让人望之生畏。"},
        {"source_segment_id": "SRC0052", "text": "“许师姐好手段，出门一次竟带回了四个拥有资质的小娃。”两个男子中的一人，带着恭维向着那女子说道。"},
        {"source_segment_id": "SRC0053", "text": "“将他们带去杂役处。”那女子神情冷漠，看都不看孟浩四人一眼，迈步间整个人化作了一道长虹，没入山峦之间消失不见。"}
      ],
      "participant_bindings": [
        ["孟浩", "person_b67de643afe6"],
        ["王有材", "person_e79ecc6793f5"],
        ["许师姐", "person_224fd998b1e7"],
        ["大青山被困少年甲", "person_b9cd0397a07f"],
        ["大青山被困少年乙", "person_32ce878a56e2"],
        ["绿袍执事甲", "person_46e7e8b742ed"],
        ["绿袍执事乙", "person_8ff1cb1a5861"]
      ]
    },
    {
      "scene_plan_key": "bp-sc014",
      "node_keys": ["S002-S001-N015", "S003-S002-S001-N016"],
      "source_segments": [
        {"source_segment_id": "SRC0054", "text": "此刻的孟浩已恢复了心神，他怔怔的看着那女子消失的地方，目中渐渐竟露出了一抹在他身上十六年来前所未有的神采，这神采让孟浩的内心，一下子沸腾了。"},
        {"source_segment_id": "SRC0055", "text": "“杂役？这是要给仙人打工，应该不少赚吧。”孟浩期待起来，因为他看出来了，这里的人不是要害命。"},
        {"source_segment_id": "SRC0056", "text": "“许师姐已经到了凝气第七层，被掌教赐了风幡，没到筑基便可飞行，让人羡慕。”另一个绿袍修士，感慨的说道，随后神色带着高高在上之意，看向孟浩四人。"},
        {"source_segment_id": "SRC0057", "text": "“你，还有你，跟我走，去南区杂役处。”话语间，此人指了指王有材和其旁虎头虎脑的少年。"}
      ],
      "participant_bindings": [
        ["孟浩", "person_b67de643afe6"],
        ["绿袍执事甲", "person_46e7e8b742ed"],
        ["绿袍执事乙", "person_8ff1cb1a5861"],
        ["王有材", "person_e79ecc6793f5"],
        ["大青山被困少年乙", "person_32ce878a56e2"]
      ]
    },
    {
      "scene_plan_key": "bp-sc015",
      "node_keys": ["S003-S002-S001-N017"],
      "source_segments": [
        {"source_segment_id": "SRC0058", "text": "“这……这里是什么地方？”被那人一指，王有材身子哆嗦，打着颤音开口。"},
        {"source_segment_id": "SRC0059", "text": "“靠山宗。”"}
      ],
      "participant_bindings": [
        ["王有材", "person_e79ecc6793f5"],
        ["绿袍执事甲", "person_46e7e8b742ed"],
