            "onscreen_entity_keys": [],
            "participant_deliveries": [],
            "performance": "舒缓的古乐渐起，镜头随水墨流动缓慢推展，整体氛围古朴悠远。",
            "render_policy": "standalone",
            "resulting_state": "故事开篇世界观背景正式引出。",
            "source_segment_ids": [
              "SRC0001"
            ],
            "source_text": "",
            "speaker_key": null,
            "target_keys": [],
            "text": "淡墨晕染的长卷缓缓铺开，南赡大地的山河轮廓在画面上逐渐清晰，“第一章 书生孟浩”的墨字逐笔显现，落在卷首。",
            "unit_key": "bp-sc001:SRC0001:001:unit"
          },
          {
            "actor_keys": [],
            "chain_key": "",
            "event_key": "bp-sc001:SRC0002:001:event",
            "event_priority": "causal",
            "function": "statement",
            "kind": "action",
            "narrative_layer": "story",
            "onscreen_entity_keys": [],
            "participant_deliveries": [],
            "performance": "镜头从山水远景落到都城地标，风铎晃动带出轻微铃声，烘托出时代氛围。",
            "render_policy": "standalone",
            "resulting_state": "赵国崇唐的社会背景交代完成，为孟浩的理想埋下伏笔。",
            "source_segment_ids": [
              "SRC0002"
            ],
            "source_text": "",
            "speaker_key": null,
            "target_keys": [],
            "text": "镜头扫过小国赵国的疆土，都城内与皇宫齐高的唐楼矗立在夕阳下，楼角的风铎轻轻晃动，映着举国上下对东土大唐、对长安的遥慕。",
            "unit_key": "bp-sc001:SRC0002:001:unit"
          },
          {
            "actor_keys": [],
            "chain_key": "",
            "event_key": "bp-sc001:SRC0003:001:event",
            "event_priority": "causal",
            "function": "statement",
            "kind": "action",
            "narrative_layer": "story",
            "onscreen_entity_keys": [],
            "participant_deliveries": [],
            "performance": "镜头随风的动线移动，最终定格在少年的背影上，风声隐约可闻，夕阳暖光铺满画面。",
            "render_policy": "standalone",
            "resulting_state": "少年坐在大青山山顶，衣摆被风拂动，故事主角正式登场。",
            "source_segment_ids": [
              "SRC0003"
            ],
            "source_text": "",
            "speaker_key": null,
            "target_keys": [],
            "text": "四月的风穿过北漠、掠过东土，裹着细碎的尘雾在黄昏的暖光里转了个弯，拂过大青山的草木，最终落在山顶坐着的青衫少年身上，吹得他衣摆轻轻扬起。",
            "unit_key": "bp-sc001:SRC0003:001:unit"
          }
        ]
      },
