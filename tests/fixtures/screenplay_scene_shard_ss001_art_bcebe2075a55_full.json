            ],
            "participant_deliveries": [],
            "performance": "孟浩站在山风里，身形站得笔直，视线牢牢锁着河面上的葫芦，眼眶微微泛红，直到葫芦变成一个小点再也看不清，也没有移开目光。",
            "render_policy": "standalone",
            "resulting_state": "孟浩站在山顶，目光追随着河面上远去的葫芦，情绪完成宣泄。",
            "source_segment_ids": [
              "SRC0014"
            ],
            "source_text": "",
            "speaker_key": null,
            "target_keys": [],
            "text": "山顶的孟浩站在原地，一瞬不瞬地盯着大河里载浮载沉、越飘越远的葫芦，没有眨眼，恍惚间仿佛在随着葫芦飘走的光影里看到了娘亲的笑脸，看到了儿时无忧无虑的时光——那葫芦里装着他所有没实现的理想，装着他对未来的全部憧憬，就这么顺着河水飘向不知名的远方，不知将来会被谁捡到，看到里面藏着的少年心事。",
            "unit_key": "bp-sc003:SRC0014:001:unit"
          }
        ]
