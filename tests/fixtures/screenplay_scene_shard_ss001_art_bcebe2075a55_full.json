        "source_basis": "SRC0004,SRC0005,SRC0006,SRC0007,SRC0008,SRC0009,SRC0010,SRC0011",
        "story_function": "推进本场事件并完成状态变化：孟浩特写，眉头紧锁，手里攥着葫芦，眼神茫然；孟浩垂头看着手里的葫芦，神色黯淡",
        "summary": "孟浩特写，眉头紧锁，手里攥着葫芦，眼神茫然；孟浩垂头看着手里的葫芦，神色黯淡",
        "turn": "孟浩垂头看着手里的葫芦，神色黯淡",
        "units": [
          {
            "actor_keys": [
              "person_b67de643afe6"
            ],
