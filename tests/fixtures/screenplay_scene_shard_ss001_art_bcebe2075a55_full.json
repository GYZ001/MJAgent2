            "onscreen_entity_keys": [],
            "participant_deliveries": [],
            "performance": "镜头跟着葫芦的下落轨迹移动，落到山脚下奔涌的河面上，河水翻着细碎的浪，水声清晰。",
            "render_policy": "standalone",
            "resulting_state": "葫芦落入山下通往东土的大河中。",
            "source_segment_ids": [
              "SRC0013"
            ],
            "source_text": "",
            "speaker_key": null,
            "target_keys": [],
            "text": "大青山脚下，一条大河奔涌流淌，河水四季不冻，当地人都传说这条河最终会流到东土大唐。",
            "unit_key": "bp-sc003:SRC0013:001:unit"
          },
