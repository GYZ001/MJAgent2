    },
    "environment": {
      "unit_key": "bp-sc001:SRC0002:001:unit",
      "kind": "action",
      "text": "镜头扫过小国赵国的疆土，都城内与皇宫齐高的唐楼矗立在夕阳下，楼角的风铎轻轻晃动，映着举国上下对东土大唐、对长安的遥慕。",
      "event_key": "bp-sc001:SRC0002:001:event",
      "source_segment_ids": [
        "SRC0002"
      ],
      "actor_keys": [],
      "target_keys": [],
      "speaker_key": null,
      "onscreen_entity_keys": [],
      "participant_deliveries": []
    },
    "character": {
      "unit_key": "bp-sc002:SRC0004:001:unit",
      "kind": "action",
      "text": "镜头转到少年正面，他身形有些瘦弱，穿着洗得干净的蓝色文士长衫，约莫十六七岁的年纪，个子不高，皮肤带着常年日晒的浅黑，清亮的眼睛本透着几分聪颖，此刻却紧紧皱着眉，指尖攥着一个葫芦，眼神里满是茫然。",
      "event_key": "bp-sc002:SRC0004:001:event",
      "source_segment_ids": [
